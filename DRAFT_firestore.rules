rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'raphealogar24@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: Product Entity
    function isValidProduct(data) {
      return data.keys().hasAll([
          'name',
          'category',
          'description',
          'price',
          'emoji',
          'imageUrl',
          'isPublished',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name',
          'category',
          'description',
          'price',
          'emoji',
          'imageUrl',
          'isPublished',
          'ownerId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.description is string && data.description.size() >= 0 && data.description.size() <= 1000 &&
        (data.price is int || data.price is float) && data.price >= 0 && data.price <= 10000000 &&
        data.emoji is string && data.emoji.size() >= 1 && data.emoji.size() <= 16 &&
        data.imageUrl is string && data.imageUrl.size() >= 0 && data.imageUrl.size() <= 300000 &&
        data.isPublished is bool &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Store Products Collection — Public read for published items, Admin-only write
    match /products/{productId} {
      allow get: if isValidId(productId) && (
        existing().isPublished == true ||
        isAdmin()
      );

      allow list: if existing().isPublished == true ||
        (isVerifiedUser() && request.auth.token.email == 'raphealogar24@gmail.com');

      allow create: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidId(productId) &&
        isValidProduct(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'category',
          'description',
          'price',
          'emoji',
          'imageUrl',
          'isPublished',
          'updatedAt'
        ]);

      allow delete: if isAdmin() &&
        isValidId(productId);
    }

    // Admins Collection (Read-only for self/admin, no client writes)
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }
  }
}
